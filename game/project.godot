; Bogowie Olimpu - game project (Godot 4.7). Renderer: Mobile (Vulkan), R-015.
config_version=5

[application]
config/name="Bogowie Olimpu"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]
locale/translations=PackedStringArray("res://i18n/ui.pl.translation", "res://i18n/ui.en.translation", "res://i18n/buildings.pl.translation", "res://i18n/buildings.en.translation")
locale/fallback="pl"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
